# Copy this file to .env and fill in real values. .env is gitignored.

# --- Email (Gmail SMTP with an App Password) ---
# Generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.gmail.address@gmail.com
SMTP_PASS=16-character-app-password
DIGEST_TO=travis.what@gmail.com
DIGEST_FROM=your.gmail.address@gmail.com

# --- Search criteria overrides (optional, defaults live in src/config.js) ---
# LEASE_BUDGET_MONTHLY=4000
# BUSINESS_BUDGET_TOTAL=200000
# SQFT_MIN=900
# SQFT_MAX=1800
